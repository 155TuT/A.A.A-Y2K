Screen { background: #10171b; color: #e7eee9; }
Button { background: #10171b; color: #d3dfd9; border: solid #61736e; min-width: 6; height: 3; padding: 0; content-align: center middle; text-style: none; }
Button:hover { background: #203d32; color: #b2efc8; border: solid #b2efc8; }
Button:focus { border: solid #b2efc8; text-style: none; }
Button.-active { background: #b2efc8; color: #10171b; }
Button:disabled { color: #51635d; border: solid #34443f; background: #10171b; }
Button.primary { color: #b2efc8; border: solid #b2efc8; }
Button.level-selected { color: #b2efc8; background: #20372d; border: solid #b2efc8; }
Input { background: #17231f; color: #e7eee9; border: solid #61736e; height: 3; padding: 0 1; }
Input:focus { border: solid #b2efc8; }
Select { height: 3; }
SelectCurrent { background: #17231f; border: solid #61736e; }
SelectOverlay { background: #17231f; color: #e7eee9; border: solid #b2efc8; }
#titlebar { height: 3; padding: 0 2; }
#brand { width: 1fr; height: 1fr; content-align: left middle; color: #b2efc8; }
#resolution { width: 17; }
.window-button { width: 5; min-width: 5; border: none; }
#workspace { height: 1fr; margin: 1 2 0 2; }
#play-pane { width: 1fr; height: 1fr; }
#board-title { height: 1; color: #b2efc8; }
#board { height: 1fr; width: 1fr; overflow: hidden; }
#caption { height: 1; color: #869d92; content-align: center middle; }
#side { width: 29; margin-left: 3; padding-left: 2; border-left: solid #3c5048; }
#level-tabs { height: 3; margin-bottom: 1; }
#level-tabs Button { width: 1fr; min-width: 6; margin-right: 1; }
#level-name { height: 1; color: #e7eee9; }
#lives-label { height: 1; color: #869d92; }
#hearts { height: 4; }
#stats { height: 1; color: #b2efc8; }
#status { height: 3; }
.button-row { height: 3; }
.button-row Button { width: 1fr; margin-right: 1; }
#custom { width: 100%; margin-top: 1; }
#footer { height: 2; padding: 0 2; border-top: solid #3c5048; color: #869d92; }
.hidden { display: none; }
#editor-panel { height: 1fr; }
#editor-panel .field-label { height: 1; color: #869d92; }
#editor-panel Input { margin-bottom: 0; }
#editor-status { height: 2; color: #b2efc8; }
#map-path { height: 3; }
#editor-help { height: 1; color: #869d92; }
#parameters { height: 3; }
#parameters Input { width: 1fr; }
#file-actions Button { margin-right: 0; min-width: 8; }
